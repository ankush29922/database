[Unit]
Description=CompactDB durable Telegram deployment notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/compactdb-telegram-notifier.py update
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/compactdb
ReadWritePaths=/var/lib/compactdb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=compactdb-notifier
