#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

ENV = Path("/etc/compactdb/bot.env")
STATE = Path("/var/lib/compactdb/notification-state.json")
PENDING = Path("/var/lib/compactdb/notification-pending.json")


def atomic(path: Path, value: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, separators=(",", ":")) + "\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def environment() -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = ENV.read_text(encoding="utf-8").splitlines()
    except OSError:
        return values
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip("'\"")
    return values


def message(event: str, detail: str) -> str:
    safe = {
        "startup": "✅ CompactDB VPS bot started successfully.",
        "recovery": "✅ CompactDB bot recovered after an interruption.",
        "deployment-complete": "✅ CompactDB deployment completed and the bot is running.",
        "update-success": "✅ CompactDB code update succeeded.",
        "update-rollback": "⚠️ CompactDB code update failed; the previous release was restored.",
        "crash-loop": "🚨 CompactDB bot entered a repeated crash loop; restart backoff is active.",
        "low-disk": "⚠️ CompactDB VPS disk space is low.",
        "database-unavailable": "⚠️ CompactDB database package is unavailable.",
    }
    if event == "bot-exit" and detail not in {"success", "done"}:
        return "⚠️ CompactDB bot process exited and will be restarted automatically."
    return safe.get(event, "ℹ️ CompactDB operational state changed.")


def send(text: str) -> bool:
    env = environment()
    token = env.get("BOT_TOKEN", "")
    owners = [item.strip() for item in env.get("BOT_OWNER_IDS", "").split(",") if item.strip().isdigit()]
    if not token or not owners:
        return False
    try:
        for owner in owners:
            payload = urllib.parse.urlencode({"chat_id": owner, "text": text}).encode()
            request = urllib.request.Request(
                f"https://api.telegram.org/bot{token}/sendMessage",
                data=payload,
                method="POST",
            )
            with urllib.request.urlopen(request, timeout=15) as response:
                if response.status != 200:
                    return False
        return True
    except Exception:
        return False


def main() -> int:
    event = sys.argv[1] if len(sys.argv) > 1 else "state"
    detail = sys.argv[2] if len(sys.argv) > 2 else ""
    state: dict[str, object] = {}
    try:
        state = json.loads(STATE.read_text())
    except Exception:
        pass
    now = int(time.time())
    if event == "retry":
        try:
            pending = json.loads(PENDING.read_text())
            queued_text = str(pending["text"])
        except Exception:
            return 0
        if send(queued_text):
            PENDING.unlink(missing_ok=True)
            state["last_sent"] = now
            state["last_event"] = str(pending.get("event", "queued"))
            atomic(STATE, state)
        return 0
    if event == "bot-exit" and detail in {"success", "done"}:
        return 0
    if event == "bot-started":
        event = "recovery" if state.get("last_started") else "startup"
    if event == "bot-exit" and detail not in {"success", "done"}:
        crashes = [int(value) for value in state.get("crashes", []) if now - int(value) < 600]
        crashes.append(now)
        state["crashes"] = crashes[-10:]
        if len(crashes) >= 5:
            event = "crash-loop"
    elif event in {"startup", "recovery"}:
        state["last_started"] = now
    text = message(event, detail)
    if send(text):
        try:
            PENDING.unlink()
        except FileNotFoundError:
            pass
        state["last_sent"] = now
        state["last_event"] = event
    else:
        atomic(PENDING, {"event": event, "text": text, "queued_at": now})
    atomic(STATE, state)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
